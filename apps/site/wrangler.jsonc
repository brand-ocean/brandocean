{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "brandocean-site",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"main": "@tanstack/react-start/server-entry",
	// Beide als custom domain: wrangler beheert de DNS-records zelf. Een gewone
	// route voor www werkt niet — die CNAME't dan naar de apex, en die is zelf
	// een custom domain, wat geen geldige origin oplevert.
	"routes": [
		{ "pattern": "brandocean.nl", "custom_domain": true },
		{ "pattern": "www.brandocean.nl", "custom_domain": true }
	]
}
