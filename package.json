{
  "name": "brandocean",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n app,convex -c blue,magenta \"bun run --filter @brandocean/app dev\" \"bun run --filter @brandocean/backend dev\"",
    "dev:blunt": "bun run --filter @brandocean/blunt dev",
    "dev:site": "bun run --filter @brandocean/site dev",
    "dev:convex": "bun run --filter @brandocean/backend dev",
    "build": "bun run --filter '*' build",
    "deploy:app": "bun run --filter @brandocean/app deploy",
    "deploy:blunt": "bun run --filter @brandocean/blunt deploy",
    "deploy:site": "bun run --filter @brandocean/site deploy",
    "test": "vitest run",
    "typecheck": "for w in apps/app apps/blunt apps/site packages/ui; do (cd $w && bunx tsc --noEmit) || exit 1; done",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@cloudflare/vite-plugin": "^1.13.8",
    "@cloudflare/workers-types": "^4.20260609.1",
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/devtools-vite": "^0.5.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/lodash.throttle": "^4.1.9",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "convex-test": "^0.0.54",
    "jsdom": "^27.0.0",
    "sass-embedded": "^1.99.0",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.0.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^6.0.2",
    "vitest": "^3.0.5",
    "web-vitals": "^5.1.0",
    "wrangler": "^4.40.3"
  }
}
