ld"}],"text":"Realtime updates"}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"4 u"}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"€ 600,-"}]}]}]}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","marks":[{"type":"italic"}],"text":"Bedragen exclusief 21% BTW. Elk blok is los af te nemen — kies zelf wat en wanneer."}]},{"type":"horizontalRule"},{"type":"heading","attrs":{"textAlign":null,"level":2},"content":[{"type":"text","text":"Blok A — Contracten bewerkbaar maken · 18 uur"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Dit is het directe antwoord op de vraag van jullie boekhouder: huurcontracten aanpassen, beëindigen en overzetten zonder Moneybird te openen."}]},{"type":"table","content":[{"type":"tableRow","content":[{"type":"tableHeader","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Onderdeel"}]}]},{"type":"tableHeader","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Omschrijving"}]}]},{"type":"tableHeader","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Uren"}]}]}]},{"type":"tableRow","content":[{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Huurcontract wijzigen"}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Huurprijs en ingangsdatum van een lopend contract aanpassen vanuit het dashboard. De wijziging gaat via de API naar de juiste regel in Moneybird en de bevestiging komt direct terug. Mislukt dat, dan zie je dat meteen — het dashboard toont nooit een wijziging die Moneybird niet heeft geaccepteerd. Inclusief bevestigingsstap en een waarschuwing bij contracten die meerdere opslagruimtes omvatten."}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"6 u"}]}]}]},{"type":"tableRow","content":[{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Contract beëindigen"}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Huurder vertrekt? Het abonnement in Moneybird stopzetten én de opslagruimte vrijgeven in één handeling. De status van de ruimte springt automatisch op \"beschikbaar\"."}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"3 u"}]}]}]},{"type":"tableRow","content":[{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Huurder wisselen"}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Nieuwe huurder in een ruimte is in Moneybird twee handelingen: oud contract stopzetten per einddatum, nieuw contract starten per ingangsdatum. Wij bundelen dat tot één scherm met huurderkeuze uit de gesynchroniseerde contacten, datumcontrole en bevestiging."}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"5 u"}]}]}]},{"type":"tableRow","content":[{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Huurdergegevens bijwerken"}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"E-mailadres of telefoonnummer corrigeren vanuit het dashboard, waarna Moneybird automatisch wordt bijgewerkt. Moneybird blijft de administratieve bron, maar je hoeft er niet meer heen voor een simpele correctie."}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"2 u"}]}]}]},{"type":"tableRow","content":[{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Wijzigingslogboek"}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Elke prijsaanpassing, datumwijziging en huurderwissel wordt vastgelegd: wie, wanneer, oude en nieuwe waarde. Bij een meningsverschil met een huurder of bij de jaarafsluiting is precies terug te vinden wat er is gebeurd."}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"2 u"}]}]}]}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Wat dit oplevert:"},{"type":"text","text":" contractwijzigingen gebeuren op één plek in plaats van twee. Geen overtypen meer tussen dashboard en Moneybird, geen ruimte voor verschillen tussen de twee systemen, en een sluitend spoor van wie wat heeft aangepast."}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Twee dingen die we vooraf helder maken in het scherm."},{"type":"text","text":" Een prijswijziging geldt vanaf de eerstvolgende factuur — reeds verstuurde facturen blijven ongewijzigd, zoals het hoort in de boekhouding. En sommige contracten omvatten meerdere opslagruimtes tegelijk; dan tonen we expliciet welke ruimtes meeveranderen, zodat er nooit ongemerkt meer wijzigt dan bedoeld."}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Kleiner beginnen kan."},{"type":"text","text":" Alleen prijs en ingangsdatum aanpassen met logboek is 8 uur (€ 1.200,-). Daar plus beëindigen en huurder wisselen is 16 uur (€ 2.400,-). Het hele blok is 18 uur."}]},{"type":"horizontalRule"},{"type":"heading","attrs":{"textAlign":null,"level":2},"content":[{"type":"text","text":"Blok B — Facturatie & betalingen · 14 uur"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"De financiële kant: zien wie betaald heeft, zelf facturen versturen, en automatisch gewaarschuwd worden bij achterstand."}]},{"type":"table","content":[{"type":"tableRow","content":[{"type":"tableHeader","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Onderdeel"}]}]},{"type":"tableHeader","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Omschrijving"}]}]},{"type":"tableHeader","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Uren"}]}]}]},{"type":"tableRow","content":[{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Openstaande facturen & betaalstatus"}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Elke factuur in Moneybird heeft een status: open, te laat, of betaald. Wij lezen die uit en koppelen ze aan de juiste huurder en opslagruimte. Een huurder die twee maanden niet betaald heeft zie je meteen, met markering en openstaand bedrag."}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"5 u"}]}]}]},{"type":"tableRow","content":[{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Factuur aanmaken vanuit het dashboard"}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Borg, boete, hangslot of extra diensten direct als factuur versturen vanuit je eigen omgeving. Moneybird maakt de factuur aan, verstuurt hem en verwerkt de betaling."}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"5 u"}]}]}]},{"type":"tableRow","content":[{"type"