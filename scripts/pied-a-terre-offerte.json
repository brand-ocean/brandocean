heading","attrs":{"textAlign":null,"level":2},"content":[{"type":"text","text":"Included as standard"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Full "},{"type":"text","marks":[{"type":"bold"}],"text":"code ownership"},{"type":"text","text":" (repository access for you)"}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Bug-fix guarantee"},{"type":"text","text":" on delivered work within scope, including after handover"}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Documentation"},{"type":"text","text":" of deploy and (phase 2) integration overview"}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Fixed price per phase"},{"type":"text","text":", no hour surprises within this scope"}]}]}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","text":"Questions or a short call to tighten scope? Let me know."}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Brandocean"},{"type":"text","text":" · info@brandocean.nl · +31 6 4132 4721"}]}]}